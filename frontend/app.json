{
  "expo": {
    "name": "After Party",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.nightcrewmatch.k5qoxm",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Show how far tonight's after-parties are from you",
        "NSCameraUsageDescription": "Take a profile photo so matches know it's really you",
        "NSPhotoLibraryUsageDescription": "Pick a profile photo from your library"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.nightcrewmatch.k5qoxm",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-location",
        { "locationWhenInUsePermission": "Show how far tonight's after-parties are from you" }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a profile photo from your library",
          "cameraPermission": "Take a profile photo so matches know it's really you"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
